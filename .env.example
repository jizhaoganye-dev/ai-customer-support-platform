# =============================================================================
# AI Customer Support Platform — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# All variables are OPTIONAL — the app works without them using local fallbacks.
# =============================================================================

# --- Supabase (Database & Auth) ---
# Create a free project at https://supabase.com
# When configured: conversations and harassment events persist to PostgreSQL
# When absent: falls back to localStorage (client-side only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI (AI Chat & Sentiment Analysis) ---
# Get an API key at https://platform.openai.com
# When configured: uses GPT-4o-mini for chat responses and sentiment analysis
# When absent: falls back to local rule-based response engine
OPENAI_API_KEY=

# --- Optional: Analytics & Monitoring ---
# SENTRY_DSN=
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
